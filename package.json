{
  "name": "amazon-browser-mcp",
  "version": "0.1.0",
  "description": "A private, read-only Amazon order-history MCP server for Cloudflare Workers with cloud and local browser runtimes.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xRampey/amazon-browser-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/0xRampey/amazon-browser-mcp/issues"
  },
  "homepage": "https://github.com/0xRampey/amazon-browser-mcp#readme",
  "type": "module",
  "packageManager": "bun@1.3.2",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "typecheck:local": "tsc --noEmit -p tsconfig.local.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "local-agent:install-browser": "playwright-core install chromium",
    "local-agent:login": "bun scripts/local-browser-agent.ts login",
    "local-agent:serve": "bun scripts/local-browser-agent.ts serve",
    "local-agent:test": "vitest run scripts/local-browser-agent",
    "check": "bun run typecheck && bun run typecheck:local && bun run test && wrangler deploy --dry-run --config wrangler.example.jsonc"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "1.1.0",
    "@cloudflare/workers-oauth-provider": "^0.8.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.17.4",
    "playwright-core": "1.61.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260628.1",
    "@types/bun": "1.3.2",
    "linkedom": "^0.18.13",
    "typescript": "6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "4.112.0"
  },
  "engines": {
    "bun": ">=1.3.2",
    "node": ">=22"
  }
}
