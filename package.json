  },
  "homepage": "https://github.com/0xRampey/amazon-browser-mcp#readme",
  "type": "module",
  "packageManager": "bun@1.3.2",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
