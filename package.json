{
  "name": "amazon-browser-mcp",
  "version": "0.1.0",
  "description": "A private, read-only Amazon order-history MCP server for Cloudflare Workers and Browserbase.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xRampey/amazon-browser-mcp.git"
  },
  "bugs": {
