  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260628.1",
    "linkedom": "^0.18.13",
    "typescript": "6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "4.112.0"
  },
  "engines": {
    "bun": ">=1.3.2",
    "node": ">=22"
  }
}
